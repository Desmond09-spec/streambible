{
  "name": "streambible",
  "productName": "StreamBible",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "desktop:dev": "vite",
    "desktop:build": "vite build && electron-builder",
    "android:build": "vite build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "dexie": "^4.4.2",
    "express": "^5.2.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-joyride": "^3.0.2",
    "react-router-dom": "^7.14.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@eslint/js": "^9.39.4",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.2",
    "@types/peerjs": "^0.0.30",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.4.2",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.9",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.5"
  },
  "build": {
    "appId": "xyz.streambible.app",
    "productName": "StreamBible",
    "icon": "public/build.ico",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/build.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/build.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/build.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/build.ico",
      "installerHeaderIcon": "public/build.ico",
      "include": "installer.nsh"
    }
  }
}
